# Copy to .env locally — on Render set these in Dashboard > Environment
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/searchengine?retryWrites=true&w=majority
PORT=3000
# Comma-separated list of allowed frontend origins (Render will inject PORT automatically)
# For Netlify demo, set to your actual site URL(s):
# e.g. FRONTEND_URL=https://your-site.netlify.app
FRONTEND_URL=http://localhost:3000,http://localhost:3001
NODE_ENV=development
